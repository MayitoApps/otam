# OTAM - Variables de Entorno para Envío de Correos y Producción en Vercel

# 1. Destinatario de las cotizaciones (por defecto: artes.grupoorganico@gmail.com)
CONTACT_RECEIVER_EMAIL="artes.grupoorganico@gmail.com"

# 2. Motor Nodemailer con Google Workspace / Gmail App Password:
# Genera tu contraseña de aplicación en https://myaccount.google.com/apppasswords
